# =============================================================================
# API keys — copy this file to .env and fill in your values
# =============================================================================

GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here  # needed for claude-sonnet-4-6 LLM calls

# =============================================================================
# Hardware config — run `uv run python hw_config.py --export` to auto-fill
# based on your system RAM, VRAM, and CPU count.
#
# You can also set these manually:
#   DATALOADER_WORKERS           — 0 for WSL2 / low-RAM machines, 1-4 otherwise
#   DATALOADER_PIN_MEMORY        — 1 only with a real CUDA GPU (not WSL2)
#   DATALOADER_PERSISTENT_WORKERS — 1 keeps workers alive between epochs (needs WORKERS > 0)
#   TRAINING_BATCH_SIZE          — 8 is safe everywhere; 32 works with a 6GB+ GPU
#   TRAINING_DEVICE              — cuda or cpu
# =============================================================================

# DATALOADER_WORKERS=0
# DATALOADER_PIN_MEMORY=0
# DATALOADER_PERSISTENT_WORKERS=0
# TRAINING_BATCH_SIZE=8
# TRAINING_DEVICE=cpu
